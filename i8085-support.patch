+  z80_gdbarch_tdep *tdep = gdbarch_tdep<z80_gdbarch_tdep> (gdbarch);
+  tdep->addr_length = 2;
+
+  set_gdbarch_short_bit (gdbarch, TARGET_CHAR_BIT);
+  set_gdbarch_int_bit (gdbarch, 2 * TARGET_CHAR_BIT);
+  set_gdbarch_long_bit (gdbarch, 4 * TARGET_CHAR_BIT);
+  set_gdbarch_long_long_bit (gdbarch, 8 * TARGET_CHAR_BIT);
+  set_gdbarch_ptr_bit (gdbarch, 2 * TARGET_CHAR_BIT);
+  set_gdbarch_addr_bit (gdbarch, 2 * TARGET_CHAR_BIT);
+  set_gdbarch_max_insn_length (gdbarch, 3);
+
+  set_gdbarch_num_regs (gdbarch, I8085_NUM_REGS);
+  set_gdbarch_sp_regnum (gdbarch, I8085_SP_REGNUM);
+  set_gdbarch_pc_regnum (gdbarch, I8085_PC_REGNUM);
+  set_gdbarch_register_name (gdbarch, i8085_register_name);
+  set_gdbarch_register_type (gdbarch, i8085_register_type);
+  set_gdbarch_dwarf2_reg_to_regnum (gdbarch, i8085_dwarf2_reg_to_regnum);
+
+  set_gdbarch_inner_than (gdbarch, core_addr_lessthan); /* falling stack */
+  set_gdbarch_skip_prologue (gdbarch, i8085_skip_prologue);
+  set_gdbarch_return_value (gdbarch, i8085_return_value);
+
+  /* Software breakpoint: RST 1 (0xCF), an 8085 one-byte trap.  Reuse the
+     Z80 helpers, which emit a single RST byte.  */
+  set_gdbarch_breakpoint_kind_from_pc (gdbarch, z80_breakpoint_kind_from_pc);
+  set_gdbarch_sw_breakpoint_from_kind (gdbarch, z80_sw_breakpoint_from_kind);
+
+  /* Unwind via DWARF CFI (LLVM emits .debug_frame) with a simple SP-based
+     fallback -- never the Z80 prologue analyser.  */
+  dwarf2_append_unwinders (gdbarch);
+  frame_unwind_append_unwinder (gdbarch, &i8085_frame_unwind);
+
+  return gdbarch;
+}
