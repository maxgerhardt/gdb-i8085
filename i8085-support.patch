+/* ======================================================================
+   Intel 8085 (MCS-85) support.
+
+   The i8085 is handled as a distinct gdbarch (bfd mach bfd_mach_i8085).
+   Unlike the Z80 support it does NOT use a hand-written prologue analyser
+   (which crashes on LLVM's i8085 stack code); it unwinds purely via DWARF
+   CFI (.debug_frame), which the LLVM i8085 backend emits.  Its 15-register
+   model matches the i8085-trace GDB stub's g-packet and the LLVM DWARF
+   register numbering exactly, so the DWARF->gdb register map is the identity.
+   ====================================================================== */
+
+enum i8085_regnum
+{
+  I8085_B_REGNUM, I8085_C_REGNUM, I8085_D_REGNUM, I8085_E_REGNUM,
+  I8085_H_REGNUM, I8085_L_REGNUM, I8085_M_REGNUM, I8085_A_REGNUM,
+  I8085_SP_REGNUM, I8085_FLAGS_REGNUM, I8085_PSW_REGNUM, I8085_PC_REGNUM,
+  I8085_BC_REGNUM, I8085_DE_REGNUM, I8085_HL_REGNUM,
+  I8085_NUM_REGS
+};
+
+static const char *
+i8085_register_name (struct gdbarch *gdbarch, int regnum)
+{
+  static const char *const names[I8085_NUM_REGS] =
+    {
+      "b", "c", "d", "e", "h", "l", "m", "a",
+      "sp", "flags", "psw", "pc", "bc", "de", "hl"
+    };
+  if (regnum >= 0 && regnum < I8085_NUM_REGS)
+    return names[regnum];
+  return "";
+}
+
+static struct type *
+i8085_register_type (struct gdbarch *gdbarch, int regnum)
+{
+  switch (regnum)
+    {
+    case I8085_SP_REGNUM:
+    case I8085_HL_REGNUM:
+      return builtin_type (gdbarch)->builtin_data_ptr;
+    case I8085_PC_REGNUM:
+      return builtin_type (gdbarch)->builtin_func_ptr;
+    case I8085_PSW_REGNUM:
+    case I8085_BC_REGNUM:
+    case I8085_DE_REGNUM:
+      return builtin_type (gdbarch)->builtin_uint16;
+    default:
+      return builtin_type (gdbarch)->builtin_uint8;
+    }
+}
+
+/* The stub's / LLVM's DWARF register numbers are the gdb register numbers.  */
+static int
+i8085_dwarf2_reg_to_regnum (struct gdbarch *gdbarch, int reg)
+{
+  if (reg >= 0 && reg < I8085_NUM_REGS)
+    return reg;
+  return -1;
+}
+
+static CORE_ADDR
+i8085_skip_prologue (struct gdbarch *gdbarch, CORE_ADDR pc)
+{
+  CORE_ADDR post = skip_prologue_using_sal (gdbarch, pc);
+  return (post != 0 && post > pc) ? post : pc;
+}
+
+static enum return_value_convention
+i8085_return_value (struct gdbarch *gdbarch, struct value *function,
+		    struct type *valtype, struct regcache *regcache,
+		    gdb_byte *readbuf, const gdb_byte *writebuf)
+{
+  int len = valtype->length ();
+  /* LLVM i8085: 8-bit results in A, 16-bit results in HL.  Anything larger
+     is returned via memory (not reconstructed here).  */
+  if (len > 2)
+    return RETURN_VALUE_STRUCT_CONVENTION;
+  int regnum = (len == 1) ? I8085_A_REGNUM : I8085_HL_REGNUM;
+  if (readbuf != nullptr)
+    regcache->cooked_read_part (regnum, 0, len, readbuf);
+  if (writebuf != nullptr)
+    regcache->cooked_write_part (regnum, 0, len, writebuf);
+  return RETURN_VALUE_REGISTER_CONVENTION;
+}
+
+/* Fallback frame unwinder for i8085 frames that lack DWARF CFI (e.g. hand
+   written crt0 assembly). It assumes the standard call convention: CALL pushed
+   a 2-byte return address at the current SP and there is no frame pointer.
+   This is only approximate mid-function, but functions compiled by LLVM carry
+   .debug_frame CFI and are handled by the (higher priority) dwarf2 unwinder;
+   this one just keeps gdb from having no unwinder at all.  It never does the
+   Z80 prologue analysis that crashes on i8085 code.  */
+
+static void
+i8085_frame_this_id (const frame_info_ptr &this_frame, void **cache,
+		     struct frame_id *this_id)
+{
+  CORE_ADDR sp = get_frame_register_unsigned (this_frame, I8085_SP_REGNUM);
+  CORE_ADDR func = get_frame_func (this_frame);
+  *this_id = frame_id_build (sp, func);
+}
+
+static struct value *
+i8085_frame_prev_register (const frame_info_ptr &this_frame, void **cache,
+			   int regnum)
+{
+  if (regnum == I8085_PC_REGNUM)
+    {
+      CORE_ADDR sp = get_frame_register_unsigned (this_frame, I8085_SP_REGNUM);
+      CORE_ADDR ra = get_frame_memory_unsigned (this_frame, sp, 2);
+      return frame_unwind_got_constant (this_frame, regnum, ra);
+    }
+  if (regnum == I8085_SP_REGNUM)
+    {
+      CORE_ADDR sp = get_frame_register_unsigned (this_frame, I8085_SP_REGNUM);
+      return frame_unwind_got_constant (this_frame, regnum, sp + 2);
+    }
+  return frame_unwind_got_register (this_frame, regnum, regnum);
+}
+
+static const struct frame_unwind i8085_frame_unwind =
+{
+  "i8085 fallback",
+  NORMAL_FRAME,
+  default_frame_unwind_stop_reason,
+  i8085_frame_this_id,
+  i8085_frame_prev_register,
+  NULL,
+  default_frame_sniffer
+};
