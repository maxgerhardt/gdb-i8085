+/* ===================== Intel 8085 disassembler =====================
+   Ported from the i8085-trace emulator.  Renders all 8085 opcodes including
+   the undocumented ones (DSUB, ARHL, RDEL, LDHI, LDSI, RSTV, SHLX, JNX5,
+   LHLX, JX5), which alias Z80 prefix bytes and cannot be shown by the Z80
+   decoder.  Used by print_insn_z80 when the mach is bfd_mach_i8085.  */
+static char *i8085_dis_out = NULL;
+static size_t i8085_dis_len = 0;
+static void i8085_dis_printf(const char *fmt, ...) {
+    if (!i8085_dis_out || i8085_dis_len == 0) {
+        return;
+    }
+    va_list ap;
+    va_start(ap, fmt);
+    int written = vsnprintf(i8085_dis_out, i8085_dis_len, fmt, ap);
+    va_end(ap);
+    if (written < 0) {
+        return;
+    }
+    size_t w = (size_t)written;
+    if (w >= i8085_dis_len) {
+        i8085_dis_out += i8085_dis_len - 1;
+        i8085_dis_len = 1;
+    } else {
+        i8085_dis_out += w;
+        i8085_dis_len -= w;
+    }
