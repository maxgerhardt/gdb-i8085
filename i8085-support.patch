+static int
+print_insn_i8085 (bfd_vma addr, struct disassemble_info *info)
+{
+  bfd_byte code[3] = { 0, 0, 0 };
+  char buf[80];
+  int len;
+
+  if ((*info->read_memory_func) (addr, code, 1, info) != 0)
+    return -1;
+  /* Best-effort read of up to two operand bytes (may fail at a boundary).  */
+  (*info->read_memory_func) (addr + 1, code + 1, 2, info);
+
+  len = i8085_disassemble_op (code, 0, buf, sizeof buf);
+  (*info->fprintf_func) (info->stream, "%s", buf);
+  return len;
+}
 int
 print_insn_z80 (bfd_vma addr, disassemble_info * info)
 {
   struct buffer buf;
 
+  /* The Intel 8085 shares the Z80 bfd architecture but has a different
+     instruction encoding for its undocumented opcodes; use its own decoder.  */
+  if (info->mach == bfd_mach_i8085)
+    return print_insn_i8085 (addr, info);
+
   buf.base = addr;
   buf.inss = 1 << info->mach;
   buf.nn_len = info->mach == bfd_mach_ez80_adl ? 3 : 2;
