+i8085_gdbarch_init (struct gdbarch_info info, struct gdbarch_list *arches)
+{
+  /* Reuse an existing i8085 gdbarch if one matches.  */
+  for (struct gdbarch_list *best = gdbarch_list_lookup_by_info (arches, &info);
+       best != NULL;
+       best = gdbarch_list_lookup_by_info (best->next, &info))
+    if (gdbarch_bfd_arch_info (best->gdbarch)->mach == bfd_mach_i8085)
+      return best->gdbarch;
